# Copy to .env for local runs. docker-compose.yml sets its own values.
SERVICE_NAME=checkout-api
ENVIRONMENT=development
VERSION=0.1.0

DATABASE_URL=postgresql+asyncpg://checkout:checkout@localhost:5432/checkout
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO
LOG_FILE=var/log/checkout-api.log
METRICS_ENABLED=true

PAYMENT_SERVICE_URL=http://localhost:8001
PAYMENT_SERVICE_TIMEOUT=5
PAYMENT_FAILURE_RATE=0.05
